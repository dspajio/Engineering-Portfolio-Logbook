---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面未找到" description="没有找到这个页面。">
  <section class="section">
    <div class="container" style="text-align:center;padding:var(--g-6) 0">
      <p class="kicker" style="color:var(--accent)">404</p>
      <h1>页面未找到</h1>
      <p class="muted">这个地址不存在，回到首页继续浏览吧。</p>
      <p><a class="btn" href="/">回到首页</a></p>
    </div>
  </section>
</BaseLayout>